        { "id": "shop-bag", "type": "text", "prompt": "You carry your shopping home in a shopping ___.", "answer": "bag", "accepted": ["bag", "shopping bag"], "points": 1 },
        { "id": "shop-cashier", "type": "text", "prompt": "This person scans your shopping and takes your money: a ___.", "accepted": ["cashier", "checkout assistant", "shop assistant"], "points": 1 },
        { "id": "shop-list", "type": "text", "prompt": "You write this before you go shopping so you remember what to buy: a shopping ___.", "answer": "list", "accepted": ["list", "shopping list"], "points": 1 },
        { "id": "shop-trolley", "type": "text", "prompt": "You push this around a supermarket and put your groceries in it: a shopping ___.", "accepted": ["trolley", "cart", "shopping trolley", "shopping cart"], "points": 1 },
        { "id": "shop-basket", "type": "text", "prompt": "You carry this small container around a shop; you don't push it: a ___.", "answer": "basket", "points": 1 },
        { "id": "shop-sale", "type": "text", "prompt": "When products cost less than usual, they are on ___.", "answer": "sale", "points": 1 },
        { "id": "shop-queue", "type": "text", "prompt": "A line of people waiting to pay is a ___.", "answer": "queue", "accepted": ["queue", "line"], "points": 1 },
        { "id": "shop-checkout", "type": "text", "prompt": "The place where you pay in a supermarket is the ___.", "answer": "checkout", "accepted": ["checkout", "check-out", "till"], "points": 1 },
        { "id": "shop-receipt", "type": "text", "prompt": "The printed proof of what you bought and paid is a ___.", "answer": "receipt", "points": 1 },
        { "id": "shop-change", "type": "text", "prompt": "The money returned when you pay more than the price is your ___.", "answer": "change", "points": 1 },
        { "id": "shop-bag-home", "type": "text", "prompt": "After parking, you ___ the groceries from the car into the kitchen.", "answer": "carry", "accepted": ["carry", "take"], "points": 1 }
      ]
