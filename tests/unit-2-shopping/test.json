        { "id": "shop-supermarket", "type": "text", "prompt": "Name this kind of shop.", "image": { "src": "images/supermarket.svg", "alt": "Illustration of supermarket aisles and a shopping cart" }, "accepted": ["a supermarket", "supermarket"], "points": 1 }
